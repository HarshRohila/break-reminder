{
  "name": "break-reminder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && cp src/electron/renderer/*.html dist/electron/renderer/ && electron dist/electron/main.js",
    "build": "tsc -p tsconfig.json && cp src/electron/renderer/*.html dist/electron/renderer/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^35.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
